+Material* ArchiveCache::buildMaterial(size_t specIndex) {
+    auto* const archive = (uint8_t*) utils::aligned_alloc(mDecompressedSize, 8);
+    if (UTILS_UNLIKELY(archive == nullptr)) {
+        return nullptr;
+    }
+    size_t const decompressed = ZSTD_decompress(archive, mDecompressedSize, mCompressed.data(), mCompressed.size());
+    Material* material = nullptr;
+    if (!ZSTD_isError(decompressed)) {
+        material = Material::Builder()
+                .package(archive + mPackageOffsets[specIndex], mArchive->specs[specIndex].packageByteCount)
+                .build(mEngine);
+    }
+    utils::aligned_free(archive);
+    return material;
+}
